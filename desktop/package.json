{
  "name": "code-canvas-desktop",
  "productName": "代码画布",
  "version": "0.4.0",
  "description": "代码画布 (Code Canvas) Windows 桌面工作台 — 粘贴 AI 代码，立即看见作品",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/desktop.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable"
  },
  "keywords": [
    "code-canvas",
    "html",
    "svg",
    "xml",
    "preview",
    "atelier"
  ],
  "author": "Quan Zhu (zhuquan7237)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nous.codecanvas.desktop",
    "productName": "代码画布",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "CodeCanvas-Desktop-${version}-Portable.exe"
    }
  }
}
