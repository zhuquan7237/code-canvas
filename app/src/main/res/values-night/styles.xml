<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme: derive from Theme.DeviceDefault.NoActionBar for dark consistency -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/canvas_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/canvas_bg</item>
        <item name="android:navigationBarColor">@color/canvas_bg</item>
        <item name="android:textColorPrimary">@color/canvas_ink_primary</item>
        <item name="android:textColorSecondary">@color/canvas_ink_secondary</item>
        <item name="android:textColorTertiary">@color/canvas_ink_secondary</item>
        <item name="android:colorAccent">@color/canvas_primary</item>
        <item name="android:colorControlActivated">@color/canvas_primary</item>
        <item name="android:colorControlHighlight">@color/canvas_surface_subtle</item>
        <item name="android:colorControlNormal">@color/canvas_icon_on_surface</item>
        <item name="android:editTextColor">@color/canvas_ink_primary</item>
        <item name="android:textColorHint">@color/canvas_ink_secondary</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:dialogTheme">@style/AppDialogTheme</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <style name="AppDialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_surface</item>
        <item name="android:textColorPrimary">@color/canvas_ink_primary</item>
        <item name="android:textColorSecondary">@color/canvas_ink_secondary</item>
        <item name="android:colorAccent">@color/canvas_primary</item>
        <item name="android:colorControlNormal">@color/canvas_icon_on_surface</item>
        <item name="android:editTextColor">@color/canvas_ink_primary</item>
        <item name="android:textColorHint">@color/canvas_ink_secondary</item>
    </style>
</resources>