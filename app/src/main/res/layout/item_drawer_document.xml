<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer row: thumbnail, name, type + size. Compact on purpose — the drawer is
     an index, not a second gallery. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="7dp">

    <ImageView
        android:id="@+id/drawer_item_thumb"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_thumbnail"
        android:foreground="@drawable/fg_thumbnail"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/drawer_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/canvas_ink_primary"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/drawer_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="11sp"
            android:textColor="@color/canvas_ink_tertiary"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
