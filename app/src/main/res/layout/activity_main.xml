<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@color/canvas_surface">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="代码画布" android:textSize="20sp" android:textColor="@color/canvas_ink_primary" android:textStyle="bold"/><TextView android:id="@+id/txt_brand_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="粘贴代码，立即看见" android:textSize="12sp" android:textColor="@color/canvas_ink_secondary" /></LinearLayout><ImageButton android:id="@+id/btn_import" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_import" android:contentDescription="导入文件"/><ImageButton android:id="@+id/btn_new" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_add" android:contentDescription="新建画布"/></LinearLayout>
<Button android:id="@+id/btn_quick_paste_preview" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_button_primary" android:text="粘贴并预览" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_on_primary_button"/>
<EditText android:id="@+id/edit_search" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginHorizontal="16dp" android:paddingHorizontal="12dp" android:background="@drawable/bg_search" android:hint="搜索文件或代码内容" android:textSize="14sp" android:textColor="@color/canvas_ink_primary" android:textColorHint="@color/canvas_ink_secondary" android:singleLine="true"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:paddingStart="20dp" android:paddingEnd="12dp" android:gravity="center_vertical"><TextView android:id="@+id/txt_file_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我的文件" android:textSize="13sp" android:textColor="@color/canvas_ink_secondary" android:layout_weight="1"/><ImageButton android:id="@+id/btn_layout_list" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_view_list" android:contentDescription="紧凑列表"/><ImageButton android:id="@+id/btn_layout_grid" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_view_grid" android:contentDescription="方格布局"/></LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ListView android:id="@+id/list_documents" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:paddingHorizontal="12dp" android:dividerHeight="6dp" android:clipToPadding="false"/>
<GridView android:id="@+id/grid_documents" android:layout_width="match_parent" android:layout_height="match_parent" android:numColumns="2" android:horizontalSpacing="8dp" android:verticalSpacing="8dp" android:paddingHorizontal="12dp" android:stretchMode="columnWidth" android:visibility="gone"/>
<LinearLayout android:id="@+id/view_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:visibility="gone"><TextView android:id="@+id/txt_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="暂无文件" android:textSize="16sp" android:textColor="@color/canvas_ink_primary" /><TextView android:id="@+id/txt_empty_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="新建文件，或粘贴 AI 给出的代码" android:textSize="13sp" android:textColor="@color/canvas_ink_secondary" /></LinearLayout></FrameLayout>
<Button android:id="@+id/btn_check_update" android:layout_width="match_parent" android:layout_height="48dp" android:background="?android:attr/selectableItemBackground" android:text="代码画布 0.1.2 · 检查更新" android:textSize="12sp" android:textColor="@color/canvas_primary"/>
</LinearLayout>
