<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_bg">

    <!-- The browsing column. The drawer is a sibling that overlays it, so the
         panel can cover the top bar instead of pushing the page sideways. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Top bar: brand lockup left, three quiet glyphs right. The bar is the
         page, not a separate slab - no surface break, no divider. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btn_drawer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_menu"
            android:contentDescription="打开目录" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="代码画布"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/canvas_ink_primary" />

            <TextView
                android:id="@+id/txt_brand_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="粘贴代码，立即看见"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_tertiary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_import"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_import"
            android:contentDescription="导入文件" />

        <ImageButton
            android:id="@+id/btn_new"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_add"
            android:contentDescription="新建画布" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置" />
    </LinearLayout>

    <!-- Hero action: the one thing most visits are for. -->
    <Button
        android:id="@+id/btn_quick_paste_preview"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_primary"
        android:text="粘贴并预览"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:textColor="@color/text_on_primary_button" />

    <!-- Clipboard auto-detect banner slot. GONE until a renderable clip is seen. -->
    <include
        android:id="@+id/banner_clipboard"
        layout="@layout/banner_clipboard"
        android:visibility="gone" />

    <!-- Search: a pill at rest, an outline only while it has focus. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_search">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="搜索文件或代码内容"
            android:textSize="14sp"
            android:textColor="@color/canvas_ink_primary"
            android:textColorHint="@color/canvas_ink_tertiary"
            android:inputType="text"
            android:singleLine="true"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- Section header: count on the left, update + view-mode on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/txt_file_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的文件"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textColor="@color/canvas_ink_tertiary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_button_subtle"
            android:text="检查更新"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/canvas_ink_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="2dp"
            android:background="@drawable/bg_segment_track">

            <ImageButton
                android:id="@+id/btn_layout_list"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@drawable/bg_icon_toggle"
                android:tint="@color/icon_toggle_tint"
                android:src="@drawable/ic_view_list"
                android:contentDescription="紧凑列表" />

            <ImageButton
                android:id="@+id/btn_layout_grid"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@drawable/bg_icon_toggle"
                android:tint="@color/icon_toggle_tint"
                android:src="@drawable/ic_view_grid"
                android:contentDescription="方格布局" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_documents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="10dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <GridView
            android:id="@+id/grid_documents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:horizontalSpacing="12dp"
            android:verticalSpacing="12dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:stretchMode="columnWidth"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/view_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="48dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_empty_canvas"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/txt_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="把第一段代码变成作品"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_ink_primary" />

            <TextView
                android:id="@+id/txt_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="在 AI 聊天里复制 HTML、SVG 或 XML 代码，粘进来就能看到效果，不用装浏览器。"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/canvas_ink_secondary" />

            <Button
                android:id="@+id/btn_empty_paste"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:text="粘贴并预览"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_on_primary" />

            <Button
                android:id="@+id/btn_empty_import"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:text="或从手机导入代码文件"
                android:textSize="13sp"
                android:textColor="@color/canvas_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="代码只保存在本机，不会上传。"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_tertiary" />
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>

    <!-- Contextual action bar: overlays the top bar while selection is live, so the
         list never reflows and the mode never fights the browsing UI. -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@color/canvas_surface_elevated"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_selection_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="退出多选" />

        <TextView
            android:id="@+id/txt_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="已选 0 项"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/canvas_ink_primary" />

        <ImageButton
            android:id="@+id/btn_selection_all"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_select_all"
            android:contentDescription="全选" />

        <ImageButton
            android:id="@+id/btn_selection_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_share"
            android:contentDescription="分享所选" />

        <ImageButton
            android:id="@+id/btn_selection_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_delete"
            android:contentDescription="删除所选" />
    </LinearLayout>

    <!-- Catalog drawer: overlays everything (top bar included) so browsing and
         selecting never fight the navigation panel. -->
    <include layout="@layout/drawer_catalog" />
</FrameLayout>
