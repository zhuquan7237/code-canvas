<?xml version="1.0" encoding="utf-8"?>
<!-- 抽屉目录：类型筛选 + 完整文件索引。
     没有 androidx 依赖，所以这是一个自绘抽屉（遮罩 + 面板 + 位移动画），
     不是 DrawerLayout。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Scrim: tap anywhere outside the panel to close. -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas_scrim" />

    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="276dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@color/canvas_surface_elevated"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目录"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/canvas_ink_primary" />

                <TextView
                    android:id="@+id/drawer_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="全部作品"
                    android:textSize="12sp"
                    android:textColor="@color/canvas_ink_tertiary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_drawer_close"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_close"
                android:contentDescription="关闭目录" />
        </LinearLayout>

        <!-- Type filter: one row of pills, single-select. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="18dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawer_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/canvas_border" />

        <ListView
            android:id="@+id/drawer_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clipToPadding="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/canvas_border" />

        <LinearLayout
            android:id="@+id/drawer_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_sheet_action">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/canvas_icon"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="设置"
                android:textSize="14sp"
                android:textColor="@color/canvas_ink_primary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
