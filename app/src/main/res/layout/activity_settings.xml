<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_bg">

    <!-- Title bar: back glyph + title, matching the home brand bar height so the two screens
         do not jump vertically when moving between them. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:background="@color/canvas_surface">

        <ImageButton
            android:id="@+id/btn_settings_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:textColor="@color/canvas_ink_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/canvas_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- 1. 外观 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:text="外观"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/canvas_ink_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_canvas_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="主题"
                        android:textSize="15sp"
                        android:textColor="@color/canvas_ink_primary" />

                    <TextView
                        android:id="@+id/txt_appearance_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="跟随系统"
                        android:textSize="13sp"
                        android:textColor="@color/canvas_ink_secondary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    android:text="浅色、深色，或随手机的深色模式自动切换"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/canvas_ink_secondary" />

                <LinearLayout
                    android:id="@+id/group_appearance"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segment_track">

                    <Button
                        android:id="@+id/btn_appearance_light"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:text="浅色"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/segment_item_text" />

                    <Button
                        android:id="@+id/btn_appearance_dark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:text="深色"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/segment_item_text" />

                    <Button
                        android:id="@+id/btn_appearance_system"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:text="跟随系统"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/segment_item_text" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. 预览 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="预览"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/canvas_ink_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_canvas_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="允许页面脚本运行"
                            android:textSize="15sp"
                            android:textColor="@color/canvas_ink_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="图表、动画、计算器类页面需要脚本才能渲染"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.25"
                            android:textColor="@color/canvas_ink_secondary" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_scripts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="允许页面脚本运行" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/canvas_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="主页显示渲染缩略图"
                            android:textSize="15sp"
                            android:textColor="@color/canvas_ink_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="关掉后卡片只显示类型封面，列表会更省电"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.25"
                            android:textColor="@color/canvas_ink_secondary" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_thumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="主页显示渲染缩略图" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/canvas_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="新文档默认允许联网加载"
                            android:textSize="15sp"
                            android:textColor="@color/canvas_ink_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="默认关闭。开启后新打开的页面可直接加载外部图片与样式"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.25"
                            android:textColor="@color/canvas_ink_secondary" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_network"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="新文档默认允许联网加载" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. 存储 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="存储"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/canvas_ink_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_canvas_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="缩略图缓存"
                            android:textSize="15sp"
                            android:textColor="@color/canvas_ink_primary" />

                        <TextView
                            android:id="@+id/txt_cache_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="正在统计…"
                            android:textSize="12sp"
                            android:textColor="@color/canvas_ink_secondary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_clear_cache"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_button_subtle"
                        android:text="清理"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/canvas_ink_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. 关于 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="关于"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/canvas_ink_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_canvas_card">

                <TextView
                    android:id="@+id/txt_about_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:text="代码画布"
                    android:textSize="15sp"
                    android:textColor="@color/canvas_ink_primary" />

                <TextView
                    android:id="@+id/txt_about_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="14dp"
                    android:text=""
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/canvas_ink_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="48dp"
                android:layout_marginTop="20dp"
                android:text="所有数据只保存在这台手机上"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.35"
                android:gravity="center"
                android:textColor="@color/canvas_ink_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
