<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_settings" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/studio_paper">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="@dimen/space_8" android:paddingEnd="@dimen/space_16">
        <ImageButton android:id="@+id/btn_settings_back" android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min" android:padding="@dimen/space_12"
            android:scaleType="fitCenter" android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_back" android:tint="@color/studio_brand"
            android:contentDescription="@string/preferences_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="@dimen/space_8"
            android:text="@string/preferences_title" android:textSize="24sp"
            android:textStyle="bold" android:textColor="@color/canvas_ink_primary"
            android:accessibilityHeading="true" />
    </LinearLayout>

    <ScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/settings_column" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
                android:orientation="vertical" android:paddingHorizontal="@dimen/screen_inset"
                android:paddingBottom="@dimen/space_24">

            <TextView style="@style/PreferencesSection" android:layout_marginTop="@dimen/space_8"
                android:text="@string/preferences_appearance" />
            <LinearLayout style="@style/PreferencesCard">
                <LinearLayout style="@style/PreferencesRow" android:paddingBottom="0dp">
                    <TextView style="@style/PreferencesTitle" android:text="@string/preferences_theme" />
                </LinearLayout>
                <LinearLayout android:id="@+id/group_appearance" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_12">
                    <Button android:id="@+id/btn_appearance_light" style="@style/PreferencesChoice"
                        android:layout_marginEnd="@dimen/space_8" android:text="@string/preferences_theme_light" />
                    <Button android:id="@+id/btn_appearance_dark" style="@style/PreferencesChoice"
                        android:layout_marginEnd="@dimen/space_8" android:text="@string/preferences_theme_dark" />
                    <Button android:id="@+id/btn_appearance_system" style="@style/PreferencesChoice"
                        android:text="@string/preferences_theme_system" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/PreferencesSection" android:text="@string/preferences_rendering" />
            <LinearLayout style="@style/PreferencesCard">
                <LinearLayout android:id="@+id/pref_row_scripts" style="@style/PreferencesRow">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PreferencesTitle" android:text="@string/preferences_scripts" />
                        <TextView style="@style/PreferencesHint" android:text="@string/preferences_scripts_hint" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_scripts" style="@style/PreferencesSwitch"
                        android:contentDescription="@string/preferences_scripts" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/space_16" android:background="@color/studio_outline"
                    android:alpha="0.45" android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/pref_row_network" style="@style/PreferencesRow">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PreferencesTitle" android:text="@string/preferences_network" />
                        <TextView android:id="@+id/pref_network_hint" style="@style/PreferencesHint"
                            android:text="@string/preferences_network_off_hint" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_network" style="@style/PreferencesSwitch"
                        android:contentDescription="@string/preferences_network" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/PreferencesSection" android:text="@string/preferences_library" />
            <LinearLayout style="@style/PreferencesCard">
                <LinearLayout android:id="@+id/pref_row_thumbnails" style="@style/PreferencesRow">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PreferencesTitle" android:text="@string/preferences_thumbnails" />
                        <TextView style="@style/PreferencesHint" android:text="@string/preferences_thumbnails_hint" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_thumbnails" style="@style/PreferencesSwitch"
                        android:contentDescription="@string/preferences_thumbnails" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/space_16" android:background="@color/studio_outline"
                    android:alpha="0.45" android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/pref_row_clipboard_auto" style="@style/PreferencesRow">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PreferencesTitle" android:text="@string/preferences_clipboard" />
                        <TextView style="@style/PreferencesHint" android:text="@string/preferences_clipboard_hint" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_clipboard_auto" style="@style/PreferencesSwitch"
                        android:contentDescription="@string/preferences_clipboard" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/space_16" android:background="@color/studio_outline"
                    android:alpha="0.45" android:importantForAccessibility="no" />
                <LinearLayout style="@style/PreferencesRow">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PreferencesTitle" android:text="@string/preferences_cache" />
                        <TextView android:id="@+id/txt_cache_size" style="@style/PreferencesHint"
                            android:text="@string/preferences_cache_loading" />
                    </LinearLayout>
                    <Button android:id="@+id/btn_clear_cache" style="@style/PreferencesAction"
                        android:layout_width="wrap_content" android:layout_marginStart="@dimen/space_8"
                        android:text="@string/preferences_clear_cache"
                        android:contentDescription="@string/preferences_clear_cache_action" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/PreferencesSection" android:text="@string/preferences_about" />
            <LinearLayout style="@style/PreferencesCard" android:padding="@dimen/space_16">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/txt_about_version" style="@style/PreferencesTitle" />
                        <TextView android:id="@+id/txt_about_detail" style="@style/PreferencesHint" />
                    </LinearLayout>
                </LinearLayout>
                <Button android:id="@+id/btn_check_update" style="@style/PreferencesAction"
                    android:layout_width="match_parent" android:layout_marginTop="@dimen/space_12"
                    android:text="@string/preferences_check_updates" />
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
