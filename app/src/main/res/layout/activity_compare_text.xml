<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_compare" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/canvas_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/compare_title" android:textSize="21sp"
            android:textStyle="bold" android:textColor="@color/canvas_ink_primary"
            android:accessibilityHeading="true" />
        <Button android:id="@+id/btn_compare_close" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
            android:background="@drawable/bg_button_subtle" android:backgroundTint="@null"
            android:text="@string/selection_close" android:textAllCaps="false" />
    </LinearLayout>
    <ListView android:id="@+id/compare_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"
        android:clipToPadding="false" android:saveEnabled="false" android:divider="@null" />
</LinearLayout>
