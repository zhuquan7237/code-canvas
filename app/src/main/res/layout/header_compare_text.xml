<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="8dp">
    <LinearLayout android:id="@+id/compare_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginHorizontal="16dp" android:background="@drawable/bg_catalog_footer"
        android:padding="8dp">
        <TextView android:id="@+id/compare_left" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end"
            android:textSize="13sp" android:textColor="@color/canvas_ink_primary" />
        <TextView android:id="@+id/compare_right" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end"
            android:layout_marginTop="4dp" android:visibility="gone"
            android:textSize="13sp" android:textColor="@color/canvas_ink_primary" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:orientation="horizontal">
        <Button android:id="@+id/btn_compare_choose" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min" android:textAllCaps="false"
            android:background="@drawable/bg_button_subtle" android:backgroundTint="@null"
            android:textColor="@color/canvas_primary" android:text="@string/compare_pick_title" />
        <Button android:id="@+id/btn_compare_swap" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min" android:textAllCaps="false"
            android:background="@drawable/bg_button_subtle" android:backgroundTint="@null"
            android:textColor="@color/canvas_primary" android:text="@string/compare_swap" />
    </LinearLayout>
    <TextView android:id="@+id/compare_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="16dp"
        android:text="@string/compare_loading" android:accessibilityLiveRegion="polite"
        android:textSize="14sp" android:textColor="@color/canvas_ink_primary" />
    <TextView android:id="@+id/compare_eof" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="16dp"
        android:textSize="13sp" android:textColor="@color/canvas_ink_secondary"
        android:visibility="gone" />
    <TextView android:id="@+id/compare_policy" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="16dp"
        android:text="@string/compare_policy" android:textSize="12sp"
        android:textColor="@color/canvas_ink_secondary" android:visibility="gone" />
</LinearLayout>
