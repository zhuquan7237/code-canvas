<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="80dp" android:padding="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_card"><ImageView android:id="@+id/img_doc_preview" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_thumbnail" android:scaleType="centerCrop" android:contentDescription="文件缩略图"/>
