<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_editor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_bg">

    <!-- Top bar: bare glyphs, no outlined boxes. -->
    <LinearLayout
        android:id="@+id/header_editor"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@color/canvas_surface">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="返回" />

        <LinearLayout
            android:id="@+id/layout_title_clickable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/txt_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="untitled.html"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_ink_primary"
                android:singleLine="true"
                android:ellipsize="middle" />

            <!-- The unsaved marker. A dot, not a colour change: the title stays readable
                 and the state is still unmistakable. -->
            <TextView
                android:id="@+id/txt_unsaved_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="●"
                android:textSize="9sp"
                android:textColor="@color/canvas_primary"
                android:visibility="gone"
                android:contentDescription="有未保存的修改" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="7dp"
                android:src="@drawable/ic_edit"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_find"
            android:contentDescription="搜索代码" />

        <ImageButton
            android:id="@+id/btn_save"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_check"
            android:contentDescription="保存" />

        <ImageButton
            android:id="@+id/btn_export_saf"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_export"
            android:contentDescription="另存为" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_share"
            android:contentDescription="分享" />
    </LinearLayout>

    <!-- Segmented code / preview switch: one trough, one rounded pill. -->
    <LinearLayout
        android:id="@+id/layout_editor_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:background="@color/canvas_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:padding="3dp"
            android:background="@drawable/bg_segment_track">

            <TextView
                android:id="@+id/tab_code"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="代码"
                android:contentDescription="代码"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_on_primary"
                android:background="@drawable/bg_segment_item" />

            <TextView
                android:id="@+id/tab_preview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="预览"
                android:contentDescription="预览"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_ink_secondary"
                android:background="@drawable/bg_segment_item" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search bar: shown instead of the code toolbar while searching, so it never
         covers the code it is pointing at. -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:background="@color/canvas_surface"
        android:visibility="gone">

        <EditText
            android:id="@+id/edit_search_query"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="10dp"
            android:hint="查找关键词或整段代码"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:importantForAutofill="no"
            android:textColor="@color/canvas_ink_primary"
            android:textColorHint="@color/canvas_ink_secondary"
            android:contentDescription="搜索内容" />

        <TextView
            android:id="@+id/txt_search_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="52dp"
            android:gravity="center"
            android:text="0 / 0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/canvas_ink_secondary" />

        <ImageButton
            android:id="@+id/btn_search_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_arrow_up"
            android:contentDescription="上一处" />

        <ImageButton
            android:id="@+id/btn_search_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_arrow_down"
            android:contentDescription="下一处" />

        <TextView
            android:id="@+id/btn_search_case"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Aa"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_segment_item"
            android:textColor="@color/canvas_ink_secondary"
            android:contentDescription="区分大小写" />

        <ImageButton
            android:id="@+id/btn_search_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="关闭搜索" />
    </LinearLayout>

    <!-- Code actions: one row. Undo/redo are bare glyphs, paste is a text
         action, and the counters sit at the trailing edge. -->
    <LinearLayout
        android:id="@+id/toolbar_editor_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_16"
        android:background="@color/canvas_surface">

        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_undo"
            android:contentDescription="撤销" />

        <ImageButton
            android:id="@+id/btn_redo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_redo"
            android:contentDescription="重做" />

        <Button
            android:id="@+id/btn_paste"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="12dp"
            android:text="粘贴"
            android:contentDescription="粘贴"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/canvas_primary" />

        <TextView
            android:id="@+id/txt_editor_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="1 行 · 0 字符"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/canvas_ink_secondary"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/txt_save_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已保存"
            android:textSize="12sp"
            android:textColor="@color/canvas_ink_secondary" />
    </LinearLayout>

    <!-- Preview controls: appear only in preview mode. Row one is the type badge and the
         page-level actions; row two is the viewport toolbar, which is only meaningful for
         content the app can zoom (SVG and images). -->
    <LinearLayout
        android:id="@+id/toolbar_preview_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp"
        android:background="@color/canvas_surface"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/preview_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_render_mode_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HTML 渲染"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_ink_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btn_preview_refresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="60dp"
                android:background="@drawable/bg_button_subtle"
                android:paddingHorizontal="12dp"
                android:text="刷新"
                android:contentDescription="刷新预览"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_preview_network"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="76dp"
                android:background="@drawable/bg_button_subtle"
                android:paddingHorizontal="12dp"
                android:text="联网加载"
                android:contentDescription="联网加载"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary" />

            <Button
                android:id="@+id/btn_preview_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="60dp"
                android:background="@drawable/bg_button_subtle"
                android:paddingHorizontal="12dp"
                android:text="全屏"
                android:contentDescription="全屏预览"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Viewport toolbar: 适应窗口 is always present because it is the one action that
             always recovers the drawing. -->
        <LinearLayout
            android:id="@+id/viewport_toolbar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_viewport_fit"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_subtle"
                android:text="适应窗口"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_viewport_fit_content"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_subtle"
                android:text="适应内容"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_viewport_zoom_out"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_subtle"
                android:text="−"
                android:textSize="16sp"
                android:textColor="@color/canvas_ink_primary"
                android:stateListAnimator="@null"
                android:contentDescription="缩小" />

            <TextView
                android:id="@+id/txt_viewport_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:gravity="center"
                android:text="100%"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/canvas_ink_secondary" />

            <Button
                android:id="@+id/btn_viewport_zoom_in"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_button_subtle"
                android:text="+"
                android:textSize="16sp"
                android:textColor="@color/canvas_ink_primary"
                android:stateListAnimator="@null"
                android:contentDescription="放大" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_allow_js"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="允许页面脚本运行"
            android:textSize="12sp"
            android:textColor="@color/canvas_ink_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_preview_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/canvas_ink_secondary"
        android:background="@color/canvas_surface_subtle"
        android:visibility="gone" />

    <!-- Content: editor page or preview canvas. -->
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Child 0: code editor, on a white page. The line-number gutter sits outside the
             horizontal scroller so it stays put when the code scrolls sideways, and its own
             scroller is driven by the code's vertical scroll. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@color/canvas_code_surface">

            <ScrollView
                android:id="@+id/scroll_line_numbers"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/txt_line_numbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="top|end"
                    android:paddingStart="12dp"
                    android:paddingEnd="9dp"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.35"
                    android:textColor="@color/canvas_line_number"
                    android:importantForAccessibility="no" />
            </ScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/canvas_border" />

            <ScrollView
                android:id="@+id/scroll_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="vertical">

                    <com.nous.codecanvas.ui.CodeEditText
                        android:id="@+id/edit_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minWidth="360dp"
                        android:gravity="top|start"
                        android:background="@null"
                        android:padding="16dp"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.35"
                        android:textColor="@color/canvas_code_ink"
                        android:hint="输入或粘贴代码，或从文件导入…"
                        android:textColorHint="@color/canvas_ink_secondary"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:saveEnabled="false"
                        android:scrollHorizontally="true" />
            </ScrollView>
        </LinearLayout>

        <!-- Child 1: the preview canvas is a rounded card on the app background,
             so the page below never hard-cuts into the white chrome above it. -->
        <FrameLayout
            android:id="@+id/container_preview_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <FrameLayout
                android:id="@+id/preview_canvas_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_canvas_card"
                android:clipToOutline="true">

                <!-- The interactive viewport. It owns pan/pinch for vector and image content;
                     for everything else it stays passive so the page scrolls itself. -->
                <com.nous.codecanvas.ui.SvgViewport
                    android:id="@+id/preview_viewport"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <WebView
                        android:id="@+id/web_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/preview_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="图片预览" />
                </com.nous.codecanvas.ui.SvgViewport>

                <LinearLayout
                    android:id="@+id/pdf_pager"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_gravity="top"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_8"
                    android:background="@color/canvas_surface"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_pdf_prev"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:background="@drawable/bg_button_subtle"
                        android:text="上一页"
                        android:textSize="13sp"
                        android:textColor="@color/canvas_ink_primary" />

                    <TextView
                        android:id="@+id/txt_pdf_page"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:gravity="center"
                        android:text="1 / 1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/canvas_ink_primary" />

                    <Button
                        android:id="@+id/btn_pdf_next"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:background="@drawable/bg_button_subtle"
                        android:text="下一页"
                        android:textSize="13sp"
                        android:textColor="@color/canvas_ink_primary" />
                </LinearLayout>

                <!-- XML structure / validation panel -->
                <ScrollView
                    android:id="@+id/layout_xml_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:background="@color/canvas_surface"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_xml_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:background="@drawable/bg_card"
                            android:text="XML 语法安全校验：合格"
                            android:textColor="@color/canvas_success"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:id="@+id/txt_xml_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/canvas_ink_primary"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                </ScrollView>

                <!-- Floating exit fullscreen button -->
                <Button
                    android:id="@+id/btn_exit_fullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_button_subtle"
                    android:paddingHorizontal="12dp"
                    android:text="退出全屏"
                    android:textSize="12sp"
                    android:textColor="@color/canvas_ink_primary"
                    android:elevation="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/preview_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="正在准备预览…"
                    android:textSize="14sp"
                    android:textColor="@color/canvas_ink_secondary"
                    android:background="@color/canvas_surface"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </ViewFlipper>

    <!-- Symbol strip docked at the bottom: it sits right above the keyboard when
         one is open, and it no longer eats a row out of the top chrome. -->
    <HorizontalScrollView
        android:id="@+id/editor_helpers"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="28dp"
        android:paddingBottom="6dp"
        android:background="@color/canvas_surface">

        <LinearLayout
            android:id="@+id/layout_editor_helpers"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Shown INSTEAD of the editor when the file could not be loaded. The old
         behaviour was to quietly create an empty untitled.html and then save it
         over the user's file, which turned a read error into "my code is gone". -->
    <LinearLayout
        android:id="@+id/layout_editor_error"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打不开这个文件"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/canvas_ink_primary" />

        <TextView
            android:id="@+id/txt_editor_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textSize="13sp"
            android:textColor="@color/canvas_ink_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="为避免覆盖你的内容，这里不会新建空白文件。"
            android:textSize="12sp"
            android:textColor="@color/canvas_ink_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_editor_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="112dp"
                android:text="再试一次"
                android:textColor="@color/canvas_on_primary"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_editor_error_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:minWidth="112dp"
                android:text="返回"
                android:textColor="@color/canvas_ink_primary"
                android:background="@drawable/bg_button_subtle"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
