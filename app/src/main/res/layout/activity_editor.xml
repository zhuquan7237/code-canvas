<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_editor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_bg">

    <!-- Top bar: bare glyphs, no outlined boxes. -->
    <LinearLayout
        android:id="@+id/header_editor"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@color/canvas_surface">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="返回" />

        <LinearLayout
            android:id="@+id/layout_title_clickable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/txt_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="untitled.html"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_ink_primary"
                android:singleLine="true"
                android:ellipsize="middle" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="7dp"
                android:src="@drawable/ic_edit"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_export_saf"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_export"
            android:contentDescription="导出源码文件" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_share"
            android:contentDescription="分享源码" />
    </LinearLayout>

    <!-- Segmented code / preview switch: one trough, one rounded pill. -->
    <LinearLayout
        android:id="@+id/layout_editor_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:background="@color/canvas_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:padding="3dp"
            android:background="@drawable/bg_segment_track">

            <TextView
                android:id="@+id/tab_code"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="代码"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_on_primary"
                android:background="@drawable/bg_segment_item" />

            <TextView
                android:id="@+id/tab_preview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="预览"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_ink_secondary"
                android:background="@drawable/bg_segment_item" />
        </LinearLayout>
    </LinearLayout>

    <!-- Code actions: one row. Undo/redo are bare glyphs, paste is a text
         action, and the counters sit at the trailing edge. -->
    <LinearLayout
        android:id="@+id/toolbar_editor_actions"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="@color/canvas_surface">

        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_undo"
            android:contentDescription="撤销" />

        <ImageButton
            android:id="@+id/btn_redo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_redo"
            android:contentDescription="重做" />

        <Button
            android:id="@+id/btn_paste"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="12dp"
            android:text="粘贴"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/canvas_primary" />

        <TextView
            android:id="@+id/txt_editor_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="1 行 · 0 字符"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/canvas_ink_secondary"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/txt_save_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已保存"
            android:textSize="12sp"
            android:textColor="@color/canvas_ink_secondary" />
    </LinearLayout>

    <!-- Preview controls: appear only in preview mode. -->
    <LinearLayout
        android:id="@+id/toolbar_preview_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:background="@color/canvas_surface"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_render_mode_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HTML 渲染"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/canvas_ink_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btn_preview_refresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="60dp"
                android:background="@drawable/bg_button_subtle"
                android:paddingHorizontal="12dp"
                android:text="刷新"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_preview_network"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="76dp"
                android:background="@drawable/bg_button_subtle"
                android:paddingHorizontal="12dp"
                android:text="联网加载"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary" />

            <Button
                android:id="@+id/btn_preview_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="60dp"
                android:background="@drawable/bg_button_subtle"
                android:paddingHorizontal="12dp"
                android:text="全屏"
                android:textSize="12sp"
                android:textColor="@color/canvas_ink_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_allow_js"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="允许页面脚本运行"
            android:textSize="12sp"
            android:textColor="@color/canvas_ink_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_preview_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/canvas_ink_secondary"
        android:background="@color/canvas_surface_subtle"
        android:visibility="gone" />

    <!-- Content: editor page or preview canvas. -->
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Child 0: code editor, on a white page. The line-number gutter sits outside the
             horizontal scroller so it stays put when the code scrolls sideways, and its own
             scroller is driven by the code's vertical scroll. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@color/canvas_code_surface">

            <ScrollView
                android:id="@+id/scroll_line_numbers"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/txt_line_numbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="top|end"
                    android:paddingStart="12dp"
                    android:paddingEnd="9dp"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.35"
                    android:textColor="@color/canvas_line_number"
                    android:importantForAccessibility="no" />
            </ScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/canvas_border" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <ScrollView
                    android:id="@+id/scroll_code"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <com.nous.codecanvas.ui.CodeEditText
                        android:id="@+id/edit_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="360dp"
                        android:gravity="top|start"
                        android:background="@null"
                        android:padding="16dp"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.35"
                    android:textColor="@color/canvas_code_ink"
                    android:hint="输入或粘贴 HTML / SVG / XML 代码…"
                    android:textColorHint="@color/canvas_ink_secondary"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:saveEnabled="false" />
                </ScrollView>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Child 1: the preview canvas is a rounded card on the app background,
             so the page below never hard-cuts into the white chrome above it. -->
        <FrameLayout
            android:id="@+id/container_preview_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/preview_canvas_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_canvas_card"
                android:clipToOutline="true">

                <WebView
                    android:id="@+id/web_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Floating exit fullscreen button -->
                <Button
                    android:id="@+id/btn_exit_fullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_button_subtle"
                    android:paddingHorizontal="12dp"
                    android:text="退出全屏"
                    android:textSize="12sp"
                    android:textColor="@color/canvas_ink_primary"
                    android:elevation="4dp"
                    android:visibility="gone" />

                <!-- XML structure / validation panel -->
                <ScrollView
                    android:id="@+id/layout_xml_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:background="@color/canvas_surface"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_xml_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:background="@drawable/bg_card"
                            android:text="XML 语法安全校验：合格"
                            android:textColor="@color/canvas_success"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:id="@+id/txt_xml_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/canvas_ink_primary"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                </ScrollView>

                <TextView
                    android:id="@+id/preview_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="正在准备预览…"
                    android:textSize="14sp"
                    android:textColor="@color/canvas_ink_secondary"
                    android:background="@color/canvas_surface"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </ViewFlipper>

    <!-- Symbol strip docked at the bottom: it sits right above the keyboard when
         one is open, and it no longer eats a row out of the top chrome. -->
    <HorizontalScrollView
        android:id="@+id/editor_helpers"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="28dp"
        android:paddingBottom="6dp"
        android:background="@color/canvas_surface">

        <LinearLayout
            android:id="@+id/layout_editor_helpers"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Shown INSTEAD of the editor when the file could not be loaded. The old
         behaviour was to quietly create an empty untitled.html and then save it
         over the user's file, which turned a read error into "my code is gone". -->
    <LinearLayout
        android:id="@+id/layout_editor_error"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打不开这个文件"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/canvas_ink_primary" />

        <TextView
            android:id="@+id/txt_editor_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textSize="13sp"
            android:textColor="@color/canvas_ink_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="为避免覆盖你的内容，这里不会新建空白文件。"
            android:textSize="12sp"
            android:textColor="@color/canvas_ink_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_editor_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="112dp"
                android:text="再试一次"
                android:textColor="@color/canvas_on_primary"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_editor_error_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:minWidth="112dp"
                android:text="返回"
                android:textColor="@color/canvas_primary"
                android:background="?android:attr/selectableItemBackground"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
