<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_surface">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/canvas_ink_primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/canvas_ink_secondary"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/dialog_edit_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="@color/canvas_ink_primary"
        android:textColorHint="@color/canvas_ink_tertiary"
        android:textCursorDrawable="@null"
        android:textColorHighlight="@color/canvas_teal_light"
        android:textSize="14sp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/dialog_error_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/canvas_danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/dialog_btn_negative"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_subtle"
            android:text="取消"
            android:textColor="@color/canvas_ink_secondary"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/dialog_btn_positive"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_primary"
            android:text="确定"
            android:textColor="@color/text_on_primary_button"
            android:textSize="13sp"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

</LinearLayout>
