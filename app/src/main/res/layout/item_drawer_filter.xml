<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_min" android:minWidth="@dimen/touch_min"
    android:orientation="horizontal" android:gravity="center"
    android:paddingHorizontal="@dimen/space_4" android:paddingVertical="@dimen/space_8"
    android:background="@drawable/bg_catalog_choice"
    android:focusable="true" android:clickable="true">
    <TextView android:id="@+id/filter_label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"
        android:gravity="center" android:importantForAccessibility="no"
        android:textColor="@color/catalog_choice_text" />
</LinearLayout>
