<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PreferencesSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_24</item>
        <item name="android:layout_marginBottom">@dimen/space_8</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:textColor">@color/studio_brand</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="PreferencesCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_preferences_card</item>
    </style>
    <style name="PreferencesRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_12</item>
        <item name="android:paddingBottom">@dimen/space_12</item>
    </style>
    <style name="PreferencesTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/canvas_ink_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PreferencesHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_4</item>
        <item name="android:textColor">@color/canvas_ink_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.22</item>
    </style>
    <style name="PreferencesSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:layout_marginStart">@dimen/space_8</item>
        <item name="android:gravity">center</item>
        <item name="android:showText">false</item>
        <item name="android:thumbTint">@color/preferences_thumb</item>
        <item name="android:trackTint">@color/preferences_track</item>
    </style>
    <style name="PreferencesChoice">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingHorizontal">@dimen/space_4</item>
        <item name="android:paddingVertical">@dimen/space_8</item>
        <item name="android:background">@drawable/bg_catalog_choice</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/catalog_choice_text</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PreferencesAction">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:paddingHorizontal">@dimen/space_12</item>
        <item name="android:paddingVertical">@dimen/space_8</item>
        <item name="android:background">@drawable/bg_catalog_choice</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/studio_brand</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
