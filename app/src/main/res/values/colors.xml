<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      A. Day (light) semantic palette — v0.3.0 "Atelier" refresh.
      Gallery direction: warm-neutral paper surfaces, one restrained indigo accent,
      every ink measured against the surface it actually sits on.
      The numeric table at the bottom mirrors every value and is parsed by
      ColorContrastTest on the JVM; rendered views are verified by
      ThemeContrastInstrumentedTest. Do not edit one without the other.
    -->

    <!-- Surfaces -->
    <color name="canvas_bg">#F5F7FA</color>
    <color name="canvas_surface">#FFFFFF</color>
    <color name="canvas_surface_subtle">#EDF1F7</color>
    <!-- Sheets, dialogs and floating chrome sit one step above surface. -->
    <color name="canvas_surface_elevated">#FFFFFF</color>
    <color name="canvas_border">#DCE3EC</color>
    <!-- 代码行号：对代码底 5.11:1（浅）/ 6.02:1（夜），达到正文可读标准 -->
    <color name="canvas_line_number">#656E82</color>
    <color name="canvas_border_strong">#74849B</color>
    <color name="canvas_card_shadow">#14000000</color>
    <color name="canvas_scrim">#990B1424</color>

    <!-- Neutral ink -->
    <color name="canvas_ink_primary">#1A2433</color>
    <color name="canvas_ink_secondary">#53627A</color>
    <!-- Third rung: captions, counts, placeholders. >= 4.5:1 on bg/surface/
         surface_elevated; it is allowed down to 3:1 only on surface_subtle, where it
         paints chip and search chrome rather than body copy. -->
    <color name="canvas_ink_tertiary">#5F6F86</color>

    <!-- Functional / interactive ink used for thin-line icons and controls -->
    <color name="canvas_icon">#44536B</color>
    <color name="canvas_icon_on_surface">#44536B</color>
    <color name="canvas_icon_on_subtle">#44536B</color>

    <!-- Primary action (indigo) -->
    <color name="canvas_primary">#2456C6</color>
    <color name="canvas_primary_pressed">#1C43A0</color>
    <color name="canvas_on_primary">#FFFFFF</color>
    <!-- Multi-select row tint: visible against both bg and surface, quiet enough
         that the row's own ink still clears AA on top of it. -->
    <color name="canvas_selection">#D9E4F8</color>

    <!-- Success / save (jade) -->
    <color name="canvas_success">#187449</color>
    <color name="canvas_on_success">#FFFFFF</color>
    <color name="canvas_success_surface">#DCF2E6</color>
    <color name="canvas_success_border">#1E7D4E</color>

    <!-- Preview (violet) -->
    <color name="canvas_preview">#6D3FC0</color>
    <color name="canvas_on_preview">#FFFFFF</color>
    <color name="canvas_preview_surface">#EDE6FA</color>
    <color name="canvas_preview_border">#6D3FC0</color>

    <!-- Network / warning (amber) -->
    <color name="canvas_warning">#8A4A08</color>
    <color name="canvas_warning_surface">#FBEBD6</color>
    <color name="canvas_warning_border">#8A4A08</color>

    <!-- Destructive (red) -->
    <color name="canvas_danger">#B42318</color>
    <color name="canvas_on_danger">#FFFFFF</color>
    <color name="canvas_danger_surface">#FBE4E1</color>

    <!-- Disabled state: muted fill with readable ink on top. -->
    <color name="canvas_disabled_fill">#CBD5E1</color>
    <color name="canvas_disabled_ink">#4A5568</color>

    <!-- Code surface -->
    <color name="canvas_code_surface">#FFFFFF</color>
    <color name="canvas_code_ink">#0F172A</color>

    <!-- Segment / tab chrome + selected chip ink -->
    <color name="canvas_segment_track">#E4E9F2</color>
    <color name="canvas_on_segment_selected">#FFFFFF</color>

    <!-- Syntax highlighting (day) - measured against canvas_code_surface -->
    <color name="syntax_tag">#0F6B5C</color>
    <color name="syntax_attr">#1D4FB8</color>
    <color name="syntax_string">#156B32</color>
    <color name="syntax_comment">#55637A</color>

    <!--
      B. Machine-readable palette table (day).
      drumroll:p1:palette-day
        bg                       #F5F7FA
