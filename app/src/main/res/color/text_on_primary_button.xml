<?xml version="1.0" encoding="utf-8"?>
<!-- Ink for buttons that sit on @drawable/bg_button_primary.
     Enabled: on-primary (>=4.5:1 on canvas_primary).
     Disabled: the muted disabled ink, which stays >=4.5:1 on canvas_disabled_fill.
     Without this selector the enabled white ink would land on the pale disabled
     fill and the label would all but disappear. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/canvas_disabled_ink" />
    <item android:color="@color/canvas_on_primary" />
</selector>
