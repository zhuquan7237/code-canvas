<?xml version="1.0" encoding="utf-8"?>
<!-- Selection badge: a quiet ring at rest, a filled accent disc when checked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/canvas_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/canvas_border_strong" />
        </shape>
    </item>
</selector>
