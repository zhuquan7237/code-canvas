<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/studio_control"/>
            <stroke android:width="2dp" android:color="@color/studio_brand"/>
            <corners android:radius="@dimen/radius_card"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/studio_control"/>
            <stroke android:width="1dp" android:color="@color/studio_outline"/>
            <corners android:radius="@dimen/radius_card"/>
        </shape>
    </item>
</selector>
