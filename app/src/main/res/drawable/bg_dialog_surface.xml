<?xml version="1.0" encoding="utf-8"?>
<!-- Floating dialog surface: one step above surface, 20dp radius (shape
     scale's "extra large" tier). No stroke - the scrim does the separation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/canvas_surface_elevated" />
    <corners android:radius="20dp" />
</shape>
