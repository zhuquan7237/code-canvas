<?xml version="1.0" encoding="utf-8"?>
<!--
  图标背景层：硬编码白色，刻意不引用 @color/canvas_bg。

  图标资源按「启动器当前的主题」解析颜色，而启动器并不总是跟着应用的深浅色走：引用主题色时，
  浅色启动器上这一层会变成 #F5F7FA 的浅底板，深蓝的图形压在上面几乎看不清。图标必须与主题解耦。

  白色也是这枚图标的原始底色：深蓝圆角框 + 亮蓝三角的负空间靠白底才成立。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
</shape>
