<?xml version="1.0" encoding="utf-8"?>
<!--
  图标背景层：硬编码墨色，刻意不引用 @color/canvas_bg。

  图标资源会按"启动器当前的主题"解析颜色，而启动器并不总是跟着应用的深浅色走：
  引用主题色时，浅色启动器上这一层会变成 #F5F7FA 的浅底板，白色的括号压在上面
  直接消失，整个图标看起来只剩一块绿色。图标必须与主题解耦。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0D1420" />
</shape>
