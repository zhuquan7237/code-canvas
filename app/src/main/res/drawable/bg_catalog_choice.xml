<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/canvas_selection">
    <item android:top="2dp" android:bottom="2dp">
        <selector>
            <item android:state_selected="true"><shape>
                <solid android:color="@color/studio_brand" />
                <corners android:radius="@dimen/radius_control" />
            </shape></item>
            <item android:state_focused="true"><shape>
                <solid android:color="@color/studio_tonal" />
                <stroke android:width="1dp" android:color="@color/studio_brand" />
                <corners android:radius="@dimen/radius_control" />
            </shape></item>
            <item><shape>
                <solid android:color="@color/studio_paper" />
                <corners android:radius="@dimen/radius_control" />
            </shape></item>
        </selector>
    </item>
</ripple>
