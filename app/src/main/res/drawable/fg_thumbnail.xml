<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn ON TOP of the thumbnail content. A rendered page can be pure white,
     and a background border is hidden behind an opaque bitmap, so the boundary
     has to be a foreground layer or the cell looks like a missing icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/canvas_border" />
    <corners android:radius="10dp" />
</shape>
