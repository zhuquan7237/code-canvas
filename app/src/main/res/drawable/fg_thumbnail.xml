<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn ON TOP of the thumbnail content: a rendered page can be pure white,
     so the boundary must be a foreground hairline or the cell looks empty. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/canvas_border" />
    <corners android:radius="12dp" />
</shape>
