<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景层：把「代码」变成「看得见的作品」。
  - 圆角画框＝一块画布
  - 尖括号 < > ＝代码
  - 中间的点＝被渲染出来的作品
  几何落在 108 网格的 30..78 安全区内（Android 自适应图标安全区 66x66）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 画框 -->
    <path
        android:strokeColor="#E9F0FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M40,30 L68,30 A10,10 0 0 1 78,40 L78,68 A10,10 0 0 1 68,78 L40,78 A10,10 0 0 1 30,68 L30,40 A10,10 0 0 1 40,30 Z" />

    <!-- 左尖括号 -->
    <path
        android:strokeColor="#8EB4FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M45,45 L38,54 L45,63" />

    <!-- 右尖括号 -->
    <path
        android:strokeColor="#8EB4FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M63,45 L70,54 L63,63" />

    <!-- 被渲染出来的作品 -->
    <path
        android:fillColor="#5FE0C8"
        android:pathData="M54,50.4 A3.6,3.6 0 1 1 53.99,50.4 Z" />
</vector>
