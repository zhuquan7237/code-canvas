<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/canvas_selection">
    <!-- Keep the hit target at least 48dp tall; inset only what is painted. -->
    <item android:top="4dp" android:bottom="4dp">
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/canvas_selection"/>
                    <stroke android:width="2dp" android:color="@color/canvas_primary"/>
                    <corners android:radius="@dimen/radius_pill"/>
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/canvas_selection"/>
                    <stroke android:width="1dp" android:color="@color/canvas_primary"/>
                    <corners android:radius="@dimen/radius_pill"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/canvas_surface_subtle"/>
                    <stroke android:width="1dp" android:color="@color/canvas_border_strong"/>
                    <corners android:radius="@dimen/radius_pill"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
