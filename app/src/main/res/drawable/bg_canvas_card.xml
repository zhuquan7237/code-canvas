<?xml version="1.0" encoding="utf-8"?>
<!-- The preview canvas is a card that sits on the app background, so white
     chrome above it and the rendered page below it never hard-cut into each
     other. clipToOutline on the host view rounds the WebView inside it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/canvas_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/canvas_border" />
    <corners android:radius="16dp" />
</shape>
