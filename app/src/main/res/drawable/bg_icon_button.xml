<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost icon button. Resting state is only the glyph. Press and selected
     pick up a tint, so a row of icons never reads as a stack of gray tiles. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_selection" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_selection" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
