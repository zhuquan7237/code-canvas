<?xml version="1.0" encoding="utf-8"?>
<!-- Refined tactile icon button: 12dp rounded surface with hairline border at rest, accent tint when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_selection" />
            <stroke android:width="1dp" android:color="@color/canvas_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_surface_subtle" />
            <stroke android:width="1dp" android:color="@color/canvas_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
