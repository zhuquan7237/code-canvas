<?xml version="1.0" encoding="utf-8"?>
<!-- Icon button: tonal fill, no resting stroke. Press uses the selection tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_selection" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_surface_subtle" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
