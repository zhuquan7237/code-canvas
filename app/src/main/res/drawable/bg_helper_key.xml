<?xml version="1.0" encoding="utf-8"?>
<!-- Symbol strip key: flat and quiet at rest, tinted only while pressed. The
     earlier version wrapped every key in its own filled pill, which read as a
     row of bubbles rather than a keyboard accessory bar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_segment_track" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
