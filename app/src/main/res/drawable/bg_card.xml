<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery card: the frame an artwork sits in. Flat, hairline-defined, 16dp
     radius (the shape scale's "large" tier). Pressed state darkens one step so
     a tap reads without a ripple box. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_surface_subtle" />
            <stroke android:width="1dp" android:color="@color/canvas_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_surface" />
            <stroke android:width="1dp" android:color="@color/canvas_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
