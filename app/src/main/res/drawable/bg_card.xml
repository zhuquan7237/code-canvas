<?xml version="1.0" encoding="utf-8"?>
<!-- Card: a quiet surface on the page background. No hairline. Press darkens one step. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_surface_subtle" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_surface" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>
